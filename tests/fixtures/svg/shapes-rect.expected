# LCV-174 AC 4, AC 5, AC 6 — sharp, rounded, `auto` and clamped rects, each
# in equivalent-path order: top side first, clockwise on screen, every side
# followed by its corner. World y = 100 - svg y.
bed 100 100
# Every stroke is red and no layer is declared, so one `#ff0000` layer.
layer "#ff0000" #ff0000 output=1 current=1
# Sharp: four lines from the top-left corner svg (10, 10) = world (10, 90).
line 0 10 90 40 90
line 0 40 90 40 70
line 0 40 70 10 70
line 0 10 70 10 90
# rx = 5, ry missing so equal: quarter circles, clockwise on screen and in
# the world, centres inset by 5 from each corner.
line 0 55 90 85 90
arc 0 85 85 5 90 0 cw
line 0 90 85 90 75
arc 0 85 75 5 0 270 cw
line 0 85 70 55 70
arc 0 55 75 5 270 180 cw
line 0 50 75 50 85
arc 0 55 85 5 180 90 cw
# rx="auto" takes ry = 4.
line 0 14 50 36 50
arc 0 36 46 4 90 0 cw
line 0 40 46 40 34
arc 0 36 34 4 0 270 cw
line 0 36 30 14 30
arc 0 14 34 4 270 180 cw
line 0 10 34 10 46
arc 0 14 46 4 180 90 cw
# rx = 30, ry missing: 30 clamps to w/2 = 20 and h/2 = 5, so the corners are
# elliptical and every side has length 0 (none imported). Centres svg
# (70, 55) = world (70, 45) for all four; parametric spans clockwise.
ellipse 0 70 45 20 5 0 90 0 cw
ellipse 0 70 45 20 5 0 0 -90 cw
ellipse 0 70 45 20 5 0 270 180 cw
ellipse 0 70 45 20 5 0 180 90 cw
