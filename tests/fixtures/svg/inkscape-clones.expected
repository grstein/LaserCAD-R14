# LCV-178 AC 1 — Inkscape clones: `<use xlink:href>` of a group placed in
# the layer (rendered in place too), a clone of a clone (AC 6), Inkscape's
# `width/height="100%"` ignored on a non-symbol target. Each clone moves the
# whole group by its transform then translate(x, y) = (0, 0).
# World y = 100 - svg y.
bed 100 100
# The group's own `stroke:#000000`: one `#000000` layer, no layer group.
layer "#000000" #000000 output=1 current=1
# In place: the closed square (10,10)-(30,20) and the circle at (20, 15) r 3.
line 0 10 90 30 90
line 0 30 90 30 80
line 0 30 80 10 80
line 0 10 80 10 90
circle 0 20 85 3
# use1: translate(40, 0).
line 0 50 90 70 90
line 0 70 90 70 80
line 0 70 80 50 80
line 0 50 80 50 90
circle 0 60 85 3
# use2: matrix(1,0,0,1,0,50) = translate(0, 50): world y - 50.
line 0 10 40 30 40
line 0 30 40 30 30
line 0 30 30 10 30
line 0 10 30 10 40
circle 0 20 35 3
# use3 -> use1 -> part: translate(0, 50) then use1's translate(40, 0).
line 0 50 40 70 40
line 0 70 40 70 30
line 0 70 30 50 30
line 0 50 30 50 40
circle 0 60 35 3
