# LCV-172 AC 2/AC 4 — three subpaths in one d, two closed with Z.
# World y = 100 - svg y.
bed 100 100
# LCV-175: every stroke is red and no layer is declared, so one `#ff0000` layer.
layer "#ff0000" #ff0000 output=1 current=1
# Subpath 1: Z closes from (30, 30) back to the start (10, 10).
line 0 10 90 30 90
line 0 30 90 30 70
line 0 30 70 10 90
# Subpath 2: the last L already returns to the start, so Z adds nothing.
line 0 50 90 70 90
line 0 70 90 70 70
line 0 70 70 50 90
# Subpath 3: open.
line 0 10 50 40 50
