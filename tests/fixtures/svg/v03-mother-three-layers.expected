# A v0.3 mother file: three layers, `Guide` with Output off, `Fine mark` current.
# World y = 300 - svg y.
bed 400 300
layer "Cut" #ff0000 output=1
layer "Fine mark" #0000ff output=1 current=1
layer "Guide" #00aa00 output=0
line 0 0 0 400 300
# M (100, 190) to (110, 200), sweep 1 = clockwise on screen, small arc:
# centre svg (100, 200) = world (100, 100); from 90 deg (top) to 0 deg, clockwise.
arc 0 100 100 10 90 0 cw
# M (230, 150) to (200, 180), large 1, sweep 0 = counter-clockwise on screen:
# centre (200, 150); from 0 deg the long way round to 270 deg (world y 120).
arc 0 200 150 30 0 270 ccw
circle 1 50.25 50.25 0.5
line 2 12.3456 300 12.3456 0
