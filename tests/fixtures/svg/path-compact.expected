# LCV-172 AC 1 — compact syntax: a sign or a second `.` starts a number
# (`10-2.5.5.5` is 10 -2.5 .5 .5), implicit repetition of `l`, exponents
# (`1e1`, `4E1`), glued flags (`0110-10` is flags 0 1, then 10 -10).
# World y = 100 - svg y.
bed 100 100
layer "Cut" #ff0000 output=1 current=1
# m10 20, l10-2.5 -> (20, 17.5), repeated l.5.5 -> (20.5, 18).
line 0 10 80 20 82.5
line 0 20 82.5 20.5 82
# h1e1 -> (30.5, 18); V4E1 -> (30.5, 40).
line 0 20.5 82 30.5 82
line 0 30.5 82 30.5 60
# a10,10 0 0 1 10 -10: (30.5, 40) to (40.5, 30), small arc, sweep 1 =
# clockwise on screen, so the centre is svg (40.5, 40) = world (40.5, 60):
# from the left (180 deg) up to the top (90 deg), clockwise.
arc 0 40.5 60 10 180 90 cw
