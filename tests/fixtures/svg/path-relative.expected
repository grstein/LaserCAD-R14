# LCV-172 AC 2 — relative m, l, h, v, a resolve against the current point.
# World y = 100 - svg y.
bed 100 100
layer "Cut" #ff0000 output=1 current=1
# m 10 10 starts at (10, 10); l 20 0 -> (30, 10); h 10 -> (40, 10); v 20 -> (40, 30).
line 0 10 90 30 90
line 0 30 90 40 90
line 0 40 90 40 70
# a 10 10 0 0 1 -20 0: (40, 30) to (20, 30), chord 20 = 2r, a half turn with
# centre svg (30, 30) = world (30, 70). sweep 1 = clockwise on screen: from
# the right (0 deg) under the bottom to the left (180 deg), clockwise.
arc 0 30 70 10 0 180 cw
# m 50 0 moves from (20, 30) to (70, 30); l 0 -20 -> (70, 10).
line 0 70 70 70 90
