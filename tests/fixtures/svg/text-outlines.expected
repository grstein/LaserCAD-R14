# LCV-179 — `<text>` with no font installed (the corpus imports with an
# empty font book): nothing is drawn, so the file's only layer is the
# default `Cut`, and each text is reported.
bed 100 100
layer "Cut" #ff0000 output=1 current=1
# Neither fill is reported: a text's fill picks its layer when it has no
# stroke, and fill="none" is exempt.
ignored 2 text (no font)
