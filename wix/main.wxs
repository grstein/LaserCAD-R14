<?xml version="1.0" encoding="UTF-8"?>
<!--
  wix/main.wxs — WiX Toolset v3 source for the LaserCAD Windows MSI installer.

  Built by `cargo wix --no-build --nocapture` (see scripts/build-msi.ps1).
  cargo-wix substitutes !(bind.FileVersion.ExeFile) / $(var.Version) at build time
  from [package].version in Cargo.toml — version strings must NOT be hardcoded here.

  UpgradeCode is stable for all LaserCAD v2 releases; do not regenerate it.
-->
<?if $(var.Platform) = x64 ?>
  <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
  <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="LaserCAD"
    Language="1033"
    Version="!(bind.FileVersion.ExeFile)"
    Manufacturer="LaserCAD contributors"
    UpgradeCode="{3837E20F-6DD3-4457-885D-A422E94A9DF6}">

    <Package
      InstallerVersion="405"
      Compressed="yes"
      InstallScope="perMachine"
      Platform="x64"
      Description="LaserCAD v2 — KISS 2D CAD for laser cutting"
      Manufacturer="LaserCAD contributors" />

    <!-- Automatically remove the previous installation when a newer version is installed. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of LaserCAD is already installed." />

    <!-- Embed all files in a single compressed cabinet. -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Application icon for Add/Remove Programs. -->
    <Icon Id="LaserCADIcon" SourceFile="$(var.CargoTargetBinDir)\..\..\..\assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="LaserCADIcon" />

    <!-- ------------------------------------------------------------------ -->
    <!-- Directory layout                                                     -->
    <!-- ------------------------------------------------------------------ -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="$(var.PlatformProgramFilesFolder)">
        <Directory Id="APPLICATIONFOLDER" Name="LaserCAD">
          <!-- Main executable -->
          <Component Id="ApplicationExe" Guid="*">
            <File
              Id="ExeFile"
              Source="$(var.CargoTargetBinDir)\lasercad.exe"
              KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <!-- Start Menu shortcut -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="LaserCAD">
          <Component Id="ApplicationShortcut" Guid="*">
            <Shortcut
              Id="ApplicationStartMenuShortcut"
              Name="LaserCAD"
              Description="LaserCAD v2 — KISS 2D CAD for laser cutting"
              Target="[APPLICATIONFOLDER]lasercad.exe"
              WorkingDirectory="APPLICATIONFOLDER"
              Icon="LaserCADIcon"
              IconIndex="0" />
            <!-- RemoveFolder/RegistryValue are required for the shortcut
                 component to have a proper key path. -->
            <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
            <RegistryValue
              Root="HKCU"
              Key="Software\LaserCAD"
              Name="installed"
              Type="integer"
              Value="1"
              KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <!-- ------------------------------------------------------------------ -->
    <!-- Feature                                                              -->
    <!-- ------------------------------------------------------------------ -->
    <Feature Id="MainApplication" Title="LaserCAD" Level="1">
      <ComponentRef Id="ApplicationExe" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

  </Product>
</Wix>
